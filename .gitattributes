reproduction/** -text
/README.md text eol=lf
/.gitignore text eol=lf
/.gitattributes text eol=lf
simulation/** -text whitespace=cr-at-eol
simulation_expanded/** -text whitespace=cr-at-eol
# Preserve generated SVG bytes, including Matplotlib path-coordinate whitespace.
simulation_expanded/figures/*.svg -text whitespace=-blank-at-eol,cr-at-eol
docs/assets/images/figure[0-9]*.svg -text whitespace=-blank-at-eol,cr-at-eol

# Reading-copy hashes refer to exact bytes; preserve them on checkout.
translations/** -text
